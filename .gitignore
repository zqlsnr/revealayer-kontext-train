# ---------------------------------------------------------------------------
# Every content rule below is anchored to the repository root on purpose.
# An unanchored rule such as "models/" also matches
# diffusers/src/diffusers/models/ (the vendored library's core package) and
# would silently drop it -- together with the tracked models/*.py source files.
# Write "/dir/" or "/models/*/" when you mean "only at the top level".
# ---------------------------------------------------------------------------

# ---- downloaded data & checkpoints (never commit) ----
/data/
/models/*/
/ckpts/
/results_single/
/validate_out/
/wandb/

# ---- training artifacts ----
# the reported training curve stays in the repository: output/stage2_full/loss_log.csv
/output/*
!/output/stage2_full/
/output/stage2_full/*
!/output/stage2_full/loss_log.csv
/logs/

# ---- weights / binary checkpoints anywhere ----
*.safetensors
*.pt
*.pth
*.ckpt
*.log

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# ---- editors / OS ----
.DS_Store
.idea/
.vscode/

# ---- keep README assets and benchmark metadata ----
!/assets/**
!/assets/*.png

# ---- never commit push credentials ----
.push_key*
